---
import "../styles/tokens.css";
import "../styles/writing.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  /** Keeps the page out of search results and omits canonical/og:url (used by the 404 page). */
  noindex?: boolean;
  /** Marks Writing as the current section in the primary nav. */
  inWriting?: boolean;
  ogType?: "website" | "article";
  publishedDate?: string;
  modifiedDate?: string;
  socialImage?: {
    src: string;
    alt: string;
    width?: number;
    height?: number;
  };
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  inWriting = true,
  ogType = "website",
  publishedDate,
  modifiedDate,
  socialImage,
} = Astro.props;

if (!Astro.site) {
  throw new Error("Astro site URL is required to generate canonical metadata.");
}

const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const defaultSocialImage = {
  src: "/assets/social/garry-tipler-social-card.png",
  alt: "Black-and-gold card reading Garry Tipler and Systems for rebuilding a life, with the GT mark.",
  width: 1200,
  height: 630,
};
const selectedSocialImage = socialImage ?? defaultSocialImage;
const socialImageUrl = new URL(selectedSocialImage.src, Astro.site).toString();
const socialImageTypes = {
  ".avif": "image/avif",
  ".gif": "image/gif",
  ".jpeg": "image/jpeg",
  ".jpg": "image/jpeg",
  ".png": "image/png",
  ".webp": "image/webp",
};
const socialImageExtension = new URL(socialImageUrl).pathname.match(/\.[a-z0-9]+$/i)?.[0].toLowerCase();
const socialImageType = socialImageExtension
  ? socialImageTypes[socialImageExtension as keyof typeof socialImageTypes]
  : undefined;
const documentTitle = `${title} | Garry Tipler`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0a07" />
    <meta name="color-scheme" content="dark" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <link rel="alternate" type="application/rss+xml" title="Garry Tipler — Writing" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Garry Tipler" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    {socialImageType && <meta property="og:image:type" content={socialImageType} />}
    {selectedSocialImage.width && <meta property="og:image:width" content={selectedSocialImage.width} />}
    {selectedSocialImage.height && <meta property="og:image:height" content={selectedSocialImage.height} />}
    <meta property="og:image:alt" content={selectedSocialImage.alt} />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@garry_tipler" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={selectedSocialImage.alt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&amp;family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400..600&amp;family=Hanken+Grotesk:wght@400;500;600&amp;family=Space+Mono:ital,wght@0,400;0,700;1,400&amp;display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="chamber-light" aria-hidden="true">
      <div class="candle"></div>
      <span class="ember" style="top: 620px; left: 48%;"></span>
      <span class="ember" style="top: 660px; left: 53%;"></span>
      <span class="ember" style="top: 700px; left: 44%;"></span>
    </div>
    <div class="chamber-nav-band chamber-wrap">
      <nav class="chamber-nav" aria-label="Primary">
        <a class="chamber-mark" href="/" aria-label="Garry Tipler home">
          <img src="/favicon.svg" alt="" width="34" height="34" />
          <span aria-hidden="true">GARRY TIPLER</span>
        </a>
        <div class="chamber-links">
          <a class="chamber-book" href="/#book">Book</a>
          <a href="/writing/" aria-current={inWriting ? "page" : undefined}>Writing</a>
          <a class="chamber-projects" href="/#proof">Projects</a>
          <a class="chamber-guide" href="/#field-guide">Free <span class="guide-days">7-day </span>guide</a>
        </div>
      </nav>
    </div>
    <slot />
    <div class="chamber-wrap">
      <footer class="chamber-footer">
        <span class="chamber-footer-brand"><img src="/favicon.svg" alt="" width="26" height="26" />© 2026 Garry Tipler</span>
        <nav aria-label="Connect">
          <a href="/writing/subscribe/">RSS</a>
          <a href="https://x.com/garry_tipler">X</a>
          <a href="https://medium.com/@Garry_Tipler">Medium</a>
        </nav>
      </footer>
    </div>
    <!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "b5edd775fe9f45bd8d41d54cafb74cc6"}'></script><!-- End Cloudflare Web Analytics -->
  </body>
</html>
