---
import "../styles/tokens.css";
import "../styles/writing.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogType?: "website" | "article";
  publishedDate?: string;
  modifiedDate?: string;
  socialImage?: {
    src: string;
    alt: string;
  };
}

const {
  title,
  description,
  canonicalPath,
  ogType = "website",
  publishedDate,
  modifiedDate,
  socialImage,
} = Astro.props;

if (!Astro.site) {
  throw new Error("Astro site URL is required to generate canonical metadata.");
}

const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const defaultSocialImage = {
  src: "/assets/social/garry-tipler-social-card.png",
  alt: "Black-and-gold card reading Garry Tipler and Systems for rebuilding a life, with the GT mark.",
};
const selectedSocialImage = socialImage ?? defaultSocialImage;
const socialImageUrl = new URL(selectedSocialImage.src, Astro.site).toString();
const socialImageTypes = {
  ".avif": "image/avif",
  ".gif": "image/gif",
  ".jpeg": "image/jpeg",
  ".jpg": "image/jpeg",
  ".png": "image/png",
  ".webp": "image/webp",
};
const socialImageExtension = new URL(socialImageUrl).pathname.match(/\.[a-z0-9]+$/i)?.[0].toLowerCase();
const socialImageType = socialImageExtension
  ? socialImageTypes[socialImageExtension as keyof typeof socialImageTypes]
  : undefined;
const documentTitle = `${title} | Garry Tipler`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Garry Tipler — Writing" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Garry Tipler" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    {socialImageType && <meta property="og:image:type" content={socialImageType} />}
    {!socialImage && <meta property="og:image:width" content="1200" />}
    {!socialImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={selectedSocialImage.alt} />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@garry_tipler" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={selectedSocialImage.alt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&amp;family=Hanken+Grotesk:wght@400;600&amp;family=JetBrains+Mono:wght@400;500;600&amp;display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
