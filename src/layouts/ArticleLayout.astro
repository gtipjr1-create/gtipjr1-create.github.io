---
import BaseLayout from "./BaseLayout.astro";
import {
  formatReadingTime,
  formatWritingDate,
  getEffectivePublicationDate,
  getWritingCollectionLabel,
  getWritingCollectionPath,
  getWritingPath,
  toDateString,
  type WritingEntry,
} from "../lib/writing";

interface Props {
  entry: WritingEntry;
  readingTime: number;
  previous?: WritingEntry;
  next?: WritingEntry;
}

const { entry, readingTime, previous, next } = Astro.props;
const { data } = entry;
const canonicalPath = getWritingPath(data);
const collectionPath = getWritingCollectionPath(data.type);
const collectionLabel = getWritingCollectionLabel(data.type);
const effectivePublicationDate = getEffectivePublicationDate(data);
const effectiveDateString = toDateString(effectivePublicationDate);
const modifiedDate = toDateString(data.updatedDate ?? data.publishedDate ?? effectivePublicationDate);
const typeLabel = data.type === "fragment" ? `Fragment ${data.fragmentNumber}` : data.type;

if (!Astro.site) {
  throw new Error("Astro site URL is required to generate Article JSON-LD.");
}

const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.summary,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  datePublished: effectiveDateString,
  dateModified: modifiedDate,
  articleSection: data.category,
  keywords: data.tags,
  author: {
    "@type": "Person",
    name: "Garry Tipler",
    url: "https://garrytipler.com/",
  },
  publisher: {
    "@type": "Person",
    name: "Garry Tipler",
    url: "https://garrytipler.com/",
  },
};
const serializedJsonLd = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<BaseLayout
  title={data.title}
  description={data.summary}
  canonicalPath={canonicalPath}
  ogType="article"
  publishedDate={effectiveDateString}
  modifiedDate={modifiedDate}
>
  <script
    slot="head"
    id="article-jsonld"
    type="application/ld+json"
    set:html={serializedJsonLd}
  />

  <div class="article-shell">
    <header class="article-masthead">
      <nav aria-label="Breadcrumb">
        <a class="back-link" href={collectionPath}><span aria-hidden="true">←</span> {collectionLabel}</a>
      </nav>
      <p class="article-eyebrow">Writing / {typeLabel}</p>
      <h1>{data.title}</h1>
      <p class="article-summary">{data.summary}</p>
      <p class="article-meta">
        <span>{data.category}</span>
        <span aria-hidden="true">·</span>
        <time datetime={effectiveDateString}>{formatWritingDate(effectivePublicationDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{formatReadingTime(readingTime)}</span>
      </p>
    </header>

    <main id="main-content" tabindex="-1">
      <article class="article-prose">
        <slot />
      </article>

      {
        data.mediumUrl && (
          <aside class="medium-attribution" aria-label="Medium attribution">
            {data.originalPublishedDate ? (
              <p>
                Originally published on Medium on {formatWritingDate(data.originalPublishedDate)}. {" "}
                <a href={data.mediumUrl} rel="external">View the original Medium post.</a>
              </p>
            ) : (
              <p>
                Also available on Medium. {" "}
                <a href={data.mediumUrl} rel="external">View the Medium post.</a>
              </p>
            )}
          </aside>
        )
      }
    </main>

    <footer class="article-footer">
      {
        (previous || next) && (
          <nav class="article-navigation" aria-label="Writing sequence">
            {previous ? (
              <a class="sequence-link sequence-previous" href={getWritingPath(previous.data)}>
                <span class="sequence-direction">Previous</span>
                <span class="sequence-title">{previous.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a class="sequence-link sequence-next" href={getWritingPath(next.data)}>
                <span class="sequence-direction">Next</span>
                <span class="sequence-title">{next.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
      <a class="back-link" href="/writing/">Return to Writing <span aria-hidden="true">→</span></a>
    </footer>
  </div>
</BaseLayout>
