---
import BaseLayout from "./BaseLayout.astro";
import {
  formatReadingTime,
  formatWritingDate,
  getEffectivePublicationDate,
  getWritingCollectionLabel,
  getWritingCollectionPath,
  getWritingPath,
  toDateString,
  type WritingEntry,
} from "../lib/writing";

interface Props {
  entry: WritingEntry;
  readingTime: number;
  previous?: WritingEntry;
  next?: WritingEntry;
  relatedEntries: WritingEntry[];
}

const { entry, readingTime, previous, next, relatedEntries } = Astro.props;
const { data } = entry;
const canonicalPath = getWritingPath(data);
const collectionPath = data.series ? "/writing/october-2026/" : getWritingCollectionPath(data.type);
const collectionLabel = data.series ? "October: 31 Days of Writing" : getWritingCollectionLabel(data.type);
const effectivePublicationDate = getEffectivePublicationDate(data);
const effectiveDateString = toDateString(effectivePublicationDate);
const modifiedDate = toDateString(data.updatedDate ?? data.publishedDate ?? effectivePublicationDate);
const typeLabel = data.series ? `OCTOBER WRITING CHALLENGE · ${String(data.seriesDay).padStart(2, "0")} / 31` : data.type === "fragment" ? `Fragment ${data.fragmentNumber}` : data.type;
const titleParts = data.title.split(" — ");

if (!Astro.site) {
  throw new Error("Astro site URL is required to generate Article JSON-LD.");
}

const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const heroImageUrl = data.heroImage
  ? new URL(data.heroImage.src, Astro.site).toString()
  : undefined;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.summary,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  datePublished: effectiveDateString,
  dateModified: modifiedDate,
  articleSection: data.category,
  keywords: data.tags,
  ...(heroImageUrl ? { image: heroImageUrl } : {}),
  author: {
    "@type": "Person",
    name: "Garry Tipler",
    url: "https://garrytipler.com/",
  },
  publisher: {
    "@type": "Person",
    name: "Garry Tipler",
    url: "https://garrytipler.com/",
  },
};
const serializedJsonLd = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<BaseLayout
  title={data.title}
  description={data.summary}
  canonicalPath={canonicalPath}
  ogType="article"
  publishedDate={effectiveDateString}
  modifiedDate={modifiedDate}
  socialImage={data.heroImage ? { src: data.heroImage.src, alt: data.heroImage.alt } : undefined}
>
  <script
    slot="head"
    id="article-jsonld"
    type="application/ld+json"
    set:html={serializedJsonLd}
  />

  <script is:inline slot="head">
    try {
      if (localStorage.getItem("gt-reading-mode") === "paper") document.documentElement.setAttribute("data-reading", "paper");
    } catch (error) {}
  </script>

  <div class="reading-progress" aria-hidden="true"><span id="reading-progress-bar"></span></div>

  <div class="article-shell chamber-wrap" data-series={data.series}>
    <header class="article-masthead">
      {data.type === "fragment" && <span class="article-watermark" aria-hidden="true">{data.fragmentNumber}</span>}
      <div class="article-crumbs rise">
        <nav aria-label="Breadcrumb">
          <a class="back-link" href={collectionPath}><span aria-hidden="true">←</span> {collectionLabel}</a>
        </nav>
        <span class="sep" aria-hidden="true">/</span>
        <p class="article-eyebrow">{typeLabel}</p>
      </div>
      <h1 class="rise" style="--d:120ms">
        {titleParts.length === 2 ? (
          <Fragment>{titleParts[0]} — <em>{titleParts[1]}</em></Fragment>
        ) : (
          data.title
        )}
      </h1>
      <p class="article-summary rise" style="--d:220ms">{data.summary}</p>
      <p class="article-meta rise" style="--d:300ms">
        {data.series && <Fragment><span>Garry Tipler</span><span aria-hidden="true">·</span></Fragment>}
        <span>{data.category}</span>
        <span aria-hidden="true">·</span>
        <time datetime={effectiveDateString}>{formatWritingDate(effectivePublicationDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{formatReadingTime(readingTime)}</span>
      </p>
      <button class="reading-mode rise" type="button" id="reading-mode" aria-pressed="false" style="--d:360ms">
        <span class="reading-mode-swatch" aria-hidden="true"></span>
        <span id="reading-mode-label">Read on paper</span>
      </button>
    </header>

    <main id="main-content" tabindex="-1">
      {
        data.heroImage && (
          <figure class="article-hero"><img
              src={data.heroImage.src}
              alt={data.heroImage.alt}
              decoding="async"
              fetchpriority="high"
            />
            {(data.heroImage.caption || data.heroImage.credit) && (
              <figcaption>
                {data.heroImage.caption}
                {data.heroImage.caption && data.heroImage.credit && " "}
                {data.heroImage.credit && <span>Credit: {data.heroImage.credit}</span>}
              </figcaption>
            )}
          </figure>
        )
      }

      <div class="article-ornament" aria-hidden="true"><span></span></div>

      <article class="article-prose">
        <slot />
      </article>

      <div class="article-end" aria-hidden="true"><span></span></div>

      {
        data.mediumUrl && (
          <aside class="medium-attribution" aria-label="Medium attribution">
            {data.originalPublishedDate ? (
              <p>
                Originally published on Medium on {formatWritingDate(data.originalPublishedDate)}. {" "}
                <a href={data.mediumUrl} rel="external">View the original Medium post.</a>
              </p>
            ) : (
              <p>
                Also available on Medium. {" "}
                <a href={data.mediumUrl} rel="external">View the Medium post.</a>
              </p>
            )}
          </aside>
        )
      }

      {
        (relatedEntries.length > 0 || data.connections.length > 0) && (
          <div class="article-discovery">
            {relatedEntries.length > 0 && (
              <section class="article-discovery-section" aria-labelledby="related-writing-heading">
                <p class="library-kicker">Related writing</p>
                <h2 id="related-writing-heading">Continue reading</h2>
                <ul class="related-writing-list">
                  {relatedEntries.map((relatedEntry) => (
                    <li>
                      <a href={getWritingPath(relatedEntry.data)}>
                        <span class="related-writing-type">
                          {relatedEntry.data.type === "fragment"
                            ? `Fragment ${relatedEntry.data.fragmentNumber}`
                            : relatedEntry.data.type}
                        </span>
                        <span class="related-writing-title">{relatedEntry.data.title}</span>
                        <span class="related-writing-arrow" aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {data.connections.length > 0 && (
              <section class="article-discovery-section" aria-labelledby="connected-work-heading">
                <p class="library-kicker">Connections</p>
                <h2 id="connected-work-heading">Connected work</h2>
                <ul class="connection-list">
                  {data.connections.map((connection) => (
                    <li>
                      <a
                        href={connection.url}
                        rel={connection.url.startsWith("http") ? "external" : undefined}
                      >
                        <span class="connection-kind">{connection.kind}</span>
                        <span class="connection-label">{connection.label}</span>
                        <span aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        )
      }
    </main>

    <div class="article-footer">
      {
        (previous || next) && (
          <nav class="article-navigation" aria-label="Writing sequence">
            {previous ? (
              <a class="sequence-link sequence-previous" href={getWritingPath(previous.data)}>
                <span class="sequence-direction"><span aria-hidden="true">← </span>Previous</span>
                <span class="sequence-title">{previous.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a class="sequence-link sequence-next" href={getWritingPath(next.data)}>
                <span class="sequence-direction">Next<span aria-hidden="true"> →</span></span>
                <span class="sequence-title">{next.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
      <a class="back-link return-link" href={data.series ? collectionPath : "/writing/"}>{data.series ? "Return to October: 31 Days of Writing" : "Return to Writing"} <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <script is:inline>
    (function () {
      var root = document.documentElement;
      var button = document.getElementById("reading-mode");
      var label = document.getElementById("reading-mode-label");
      function sync() {
        var paper = root.getAttribute("data-reading") === "paper";
        button.setAttribute("aria-pressed", paper ? "true" : "false");
        label.textContent = paper ? "Read by candlelight" : "Read on paper";
      }
      if (button) {
        sync();
        button.addEventListener("click", function () {
          var paper = root.getAttribute("data-reading") !== "paper";
          if (paper) root.setAttribute("data-reading", "paper");
          else root.removeAttribute("data-reading");
          try { localStorage.setItem("gt-reading-mode", paper ? "paper" : "candle"); } catch (error) {}
          sync();
        });
      }
      var bar = document.getElementById("reading-progress-bar");
      var article = document.querySelector(".article-prose");
      if (!bar || !article) return;
      var ticking = false;
      function update() {
        var rect = article.getBoundingClientRect();
        var total = rect.height - window.innerHeight * 0.6;
        var progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
        bar.style.transform = "scaleX(" + progress + ")";
        ticking = false;
      }
      window.addEventListener("scroll", function () {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
      update();
    })();
  </script>
</BaseLayout>
