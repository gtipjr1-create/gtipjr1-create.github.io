---
// Homepage. Markup and styles are hand-authored (Field Manual, see
// docs/design-system.md); only the writing cards are built from the
// Writing collection so the homepage always shows the newest pieces.
import {
  getEffectivePublicationDate,
  getPublishedWritingEntries,
  getWritingCollectionLabel,
  getWritingPath,
  sortWritingByPublicationDate,
  type WritingEntry,
} from "../lib/writing";

const featuredSlug = "fragments-4-the-fire";
const published = await getPublishedWritingEntries();
const featured = published.find((entry) => entry.data.slug === featuredSlug);
if (!featured) throw new Error(`Homepage featured piece "${featuredSlug}" is not published.`);
const latest = sortWritingByPublicationDate(published)
  .filter((entry) => entry.data.slug !== featuredSlug)
  .slice(0, 2);

const shortDate = (entry: WritingEntry) =>
  new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })
    .format(getEffectivePublicationDate(entry.data));
const typeLabel = (entry: WritingEntry) => getWritingCollectionLabel(entry.data.type).replace(/s$/, "");

// Field log: whole weeks since the owner-confirmed start date. Computed at build
// time for the HTML, then kept current in the browser by the script below.
const systemStart = "2026-01-01";
const weeksInSystem = Math.floor((Date.now() - Date.parse(`${systemStart}T00:00:00`)) / 604800000);
