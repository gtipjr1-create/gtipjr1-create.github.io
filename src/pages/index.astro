<link rel="stylesheet" href="/assets/css/field-manual.css" />
<style is:inline>

  a:focus-visible, button:focus-visible, input:focus-visible {
    outline: 2px solid var(--accent-hi);
    outline-offset: 4px;
  }

  .display {
    font-family: var(--serif);
    font-weight: 300;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .display em { font-style: italic; color: var(--accent); }
  .glow {
    position: absolute; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, var(--glow) 0%, rgba(var(--accent-rgb), 0) 62%);
  }

  /* ---------- BUTTONS ---------- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    min-height: 56px; padding: 0 28px;
    border: 1px solid transparent;
    font-family: var(--sans); font-size: 16px; font-weight: 600; line-height: 1.2;
    cursor: pointer;
    transition: background .25s ease, color .25s ease, border-color .25s ease;
  }
  .btn .arrow { transition: transform .25s ease; }
  .btn:hover .arrow { transform: translateX(4px); }
  .btn-primary { background: var(--accent); color: #0b0b0c; }
  .btn-primary:hover { background: var(--accent-hi); }
  .btn-ghost { border-color: var(--line-2); color: var(--ink); font-weight: 500; }
  .text-link {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px;
    color: var(--accent); font-size: 15px; font-weight: 600;
    transition: color .2s ease;
  }
  .text-link .arrow { transition: transform .2s ease; }
  .text-link:hover { color: var(--accent-hi); }
  .text-link:hover .arrow { transform: translateX(3px); }

  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    min-height: 940px;
    display: flex; flex-direction: column;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-media {
    position: absolute; top: 0; right: 0; bottom: 0;
    width: 49%;
    z-index: -2;
  }
  .hero-media img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: 58% 50%;
    filter: saturate(0.7) contrast(1.05) brightness(0.92);
  }
  .hero-media::after {
    content: ""; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, var(--bg) 0%, rgba(11,11,12,0.55) 32%, rgba(11,11,12,0) 60%),
      linear-gradient(0deg, var(--bg) 0%, rgba(11,11,12,0) 38%);
  }
  .hero-texture .glow { top: 120px; right: 12%; width: 720px; height: 720px; background: radial-gradient(circle, rgba(var(--accent-rgb), 0.16) 0%, rgba(var(--accent-rgb), 0) 62%); }

  .nav-guide { min-height: 44px !important; padding: 0 18px; background: var(--accent); color: #0b0b0c !important; font-weight: 600; font-size: 14px; transition: background .25s ease !important; }
  .nav-guide:hover { background: var(--accent-hi); }

  .hero-copy {
    position: relative; z-index: 2;
    flex: 1;
    display: flex; flex-direction: column; justify-content: center; gap: 36px;
    max-width: 760px;
    padding: 96px 0 72px;
  }
  .hero-role { display: flex; align-items: center; gap: 14px; font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em; color: var(--ink-mute); text-transform: uppercase; }
  .pulse { width: 8px; height: 8px; flex: none; border-radius: 50%; background: var(--accent); }
  .hero h1 { font-size: clamp(56px, 8.9vw, 128px); line-height: 0.95; letter-spacing: -0.035em; }
  .lede { max-width: 560px; font-size: 20px; line-height: 1.6; color: var(--ink-dim); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }

  /* Field log: real numbers only, never estimated. */
  .field-log {
    position: relative; z-index: 2;
    margin-bottom: 56px;
    display: grid; grid-template-columns: 1.2fr 1fr 1fr 1fr 1.7fr;
    background: rgba(18, 18, 16, 0.72);
    border: 1px solid rgba(236, 234, 227, 0.09);
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
    overflow: hidden;
  }
  .field-log__sweep { position: absolute; top: 0; left: 0; width: 100%; height: 1px; overflow: hidden; }
  .field-log__sweep::before { content: ""; position: absolute; top: 0; left: 0; width: 40%; height: 1px; background: linear-gradient(90deg, rgba(var(--accent-rgb), 0), var(--accent), rgba(var(--accent-rgb), 0)); transform: translateX(-100%); }
  .field-log > div { padding: 26px 24px; display: flex; flex-direction: column; gap: 6px; }
  .field-log > div + div { border-left: 1px solid rgba(236, 234, 227, 0.08); }
  .field-log__title { display: flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 11px; font-weight: 400; letter-spacing: 0.18em; color: var(--accent); text-transform: uppercase; }
  .field-log__title .pulse { width: 6px; height: 6px; }
  .field-log__note { font-size: 14px; line-height: 1.45; color: var(--ink-mute); }
  .field-log__value { font-family: var(--serif); font-size: 52px; font-weight: 300; line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; }
  .field-log__label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; color: var(--ink-mute); text-transform: uppercase; }
  .field-log__now { justify-content: center; gap: 8px !important; }
  .field-log__now .field-log__label { color: var(--accent); }
  .field-log__now p { font-family: var(--serif); font-size: 22px; font-weight: 300; line-height: 1.25; color: var(--ink); }

  /* ---------- ABOUT ---------- */
  .about { padding: 140px 0 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; align-items: start; }
  .about-head { grid-column: span 4; display: flex; flex-direction: column; gap: 22px; }
  .about-head h2 { font-size: clamp(40px, 3.9vw, 56px); line-height: 1.02; }
  .about-portrait { width: 160px; height: 160px; margin-top: 18px; object-fit: cover; border: 1px solid var(--line-2); }
  .about-copy { grid-column: 6 / span 7; max-width: 640px; display: flex; flex-direction: column; gap: 22px; font-size: 18px; line-height: 1.7; color: var(--ink-dim); }
  .about-copy strong { color: var(--ink); font-weight: 500; }

  /* ---------- BOOK ---------- */
  .book { position: relative; padding: 112px 0 140px; overflow: hidden; }
  .book .glow { top: 60px; left: 40px; width: 820px; height: 820px; background: radial-gradient(circle, rgba(var(--accent-rgb), 0.13) 0%, rgba(var(--accent-rgb), 0) 60%); }
  .book-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: center; }
  .book-stage { position: relative; height: 700px; display: flex; align-items: center; justify-content: center; }
  .book-shadow { position: absolute; bottom: 70px; left: 50%; width: 360px; height: 40px; margin-left: -180px; border-radius: 50%; background: radial-gradient(ellipse, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0) 70%); }
  .book-object {
    position: relative; display: block; width: 360px; aspect-ratio: 600 / 960;
  }
  .book-object img { width: 100%; height: 100%; object-fit: cover; border: 1px solid #34302a; box-shadow: 40px 40px 80px rgba(0,0,0,0.6); }
  .book-object::after { content: ""; position: absolute; top: 0; left: 0; width: 16px; height: 100%; background: linear-gradient(90deg, rgba(0,0,0,0.5), rgba(255,255,255,0.06) 60%, rgba(0,0,0,0.2)); }
  .book-body { display: flex; flex-direction: column; gap: 28px; }
  .book-body h2 { font-size: clamp(52px, 6.7vw, 96px); line-height: 0.95; letter-spacing: -0.03em; }
  .book-sub { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 26px; line-height: 1.35; color: var(--ink-soft); }
  .book-desc { max-width: 540px; font-size: 18px; line-height: 1.65; color: var(--ink-mute); }
  .book-buy { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; padding-top: 8px; }
  .book-price { display: flex; flex-direction: column; gap: 2px; }
  .book-price strong { font-size: 18px; font-weight: 600; color: var(--ink); }
  .book-price span { font-size: 13px; color: var(--ink-mute); }

  .guides { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding-bottom: 160px; }
  .guide-card {
    display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 32px; align-items: center;
    padding: 32px;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, var(--bg-card-2), #0f0f0e);
    transition: transform .35s cubic-bezier(.2,.7,.2,1), border-color .35s ease;
  }
  .guide-card:hover { transform: translateY(-6px); border-color: var(--accent); }
  .guide-num { height: 160px; display: flex; align-items: center; justify-content: center; border-right: 1px solid #2e2b25; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 72px; color: var(--accent); }
  .guide-card__body { display: flex; flex-direction: column; gap: 10px; }
  .guide-card__kicker { font-family: var(--mono); font-size: 11px; letter-spacing: 0.16em; color: var(--accent); text-transform: uppercase; }
  .guide-card__name { font-family: var(--serif); font-size: 28px; line-height: 1.12; color: var(--ink); }
  .guide-card__desc { font-size: 15px; line-height: 1.55; color: var(--ink-mute); }
  .guide-card__cta { font-size: 14px; font-weight: 600; color: var(--accent); }

  /* ---------- APPS ---------- */
  .apps { position: relative; padding: 150px 0 160px; background: var(--bg-2); border-top: 1px solid #1f1e1a; border-bottom: 1px solid #1f1e1a; overflow: hidden; }
  .apps-grid { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(rgba(236,234,227,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(236,234,227,0.04) 1px, transparent 1px); background-size: 64px 64px; }
  .apps .glow { top: 380px; left: 50%; width: 1100px; height: 700px; margin-left: -550px; background: radial-gradient(ellipse, rgba(var(--accent-rgb), 0.12) 0%, rgba(var(--accent-rgb), 0) 62%); }
  .apps-head { position: relative; display: flex; flex-direction: column; align-items: center; gap: 22px; text-align: center; }
  .apps-head h2 { max-width: 980px; font-size: clamp(38px, 4.7vw, 68px); line-height: 1.02; }
  .apps-head p { max-width: 620px; font-size: 18px; line-height: 1.6; color: var(--ink-mute); }
  .showcase { position: relative; margin-top: 88px; aspect-ratio: 1280 / 560; }
  .showcase-browser {
    position: absolute; left: 9.4%; top: 7.1%; width: 67.2%;
    display: flex; flex-direction: column;
    background: #151513; border: 1px solid #2e2b25;
    box-shadow: 0 40px 100px rgba(0,0,0,0.7);
  }
  .showcase-browser__bar { height: 40px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 16px; border-bottom: 1px solid var(--line); }
  .showcase-browser__bar span { width: 10px; height: 10px; border-radius: 50%; background: #34302a; }
  .showcase-browser img { width: 100%; height: auto; aspect-ratio: 860 / 460; object-fit: cover; object-position: left top; }
  .showcase-phone {
    position: absolute; right: 11.7%; top: 0; width: 21.9%; aspect-ratio: 1 / 2;
    border-radius: clamp(22px, 3.1vw, 44px);
    border: 1px solid var(--line-2);
    box-shadow: 0 50px 100px rgba(0,0,0,0.8), 0 0 0 8px #161614;
    overflow: hidden; background: #000;
  }
  .showcase-phone img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .app-notes { position: relative; margin-top: 72px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .app-note { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding-top: 24px; border-top: 1px solid var(--line-2); }
  .app-note__title { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
  .app-note h3 { font-family: var(--serif); font-weight: 400; font-size: 34px; line-height: 1.1; color: var(--ink); }
  .app-status { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; color: var(--ink-mute); text-transform: uppercase; }
  .app-status--live { color: var(--accent); }
  .app-status--live .pulse { width: 6px; height: 6px; }
  .app-note p { max-width: 520px; font-size: 16px; line-height: 1.55; color: var(--ink-mute); }

  /* ---------- PRINCIPLES ---------- */
  .principles { padding: 150px 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; align-items: start; }
  .principles-head { grid-column: span 4; display: flex; flex-direction: column; gap: 22px; position: sticky; top: 40px; }
  .principles-head h2 { font-size: clamp(40px, 3.9vw, 56px); line-height: 1.02; }
  .principles ol { grid-column: 6 / span 7; list-style: none; }
  .principle { position: relative; display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 24px; align-items: baseline; padding: 30px 0; border-top: 1px solid var(--line); }
  .principle::before { content: ""; position: absolute; top: -1px; left: 0; height: 1px; width: 0; background: var(--accent); transition: width 2.4s linear; }
  .principle__num { font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; color: var(--ink-faint); transition: color .6s ease; }
  .principle__text { font-family: var(--serif); font-weight: 300; font-size: clamp(26px, 2.7vw, 38px); line-height: 1.18; color: var(--ink-off); transition: color .6s ease; }
  .principle.is-active::before { width: 100%; }
  .principle.is-active .principle__num { color: var(--accent); }
  .principle.is-active .principle__text { color: var(--ink); }
  .principles.is-static .principle__text { color: var(--ink); }

  /* ---------- WRITING ---------- */
  .writing { padding: 150px 0 0; display: flex; flex-direction: column; gap: 48px; }
  .writing-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 32px; }
  .writing-head > div { display: flex; flex-direction: column; gap: 20px; }
  .writing-head h2 { font-size: clamp(40px, 3.9vw, 56px); line-height: 1.02; }
  .writing-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 24px; }
  .writing-grid--single { grid-template-columns: minmax(0, 1fr); }
  .writing-side { display: flex; flex-direction: column; gap: 24px; }
  .card { border: 1px solid var(--line); background: var(--bg-card); transition: transform .35s cubic-bezier(.2,.7,.2,1), border-color .35s ease; }
  .card:hover { transform: translateY(-6px); border-color: var(--accent); }
  .card-feature { position: relative; display: flex; flex-direction: column; justify-content: flex-end; gap: 16px; min-height: 460px; padding: 44px; overflow: hidden; }
  .card-feature .glow { top: -120px; right: -120px; width: 460px; height: 460px; background: radial-gradient(circle, rgba(var(--accent-rgb), 0.2) 0%, rgba(var(--accent-rgb), 0) 65%); }
  .card-feature__mark { position: absolute; top: 12px; left: 32px; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 300px; line-height: 1; letter-spacing: -0.04em; color: rgba(var(--accent-rgb), 0.13); pointer-events: none; }
  .card-feature > *:not(.glow):not(.card-feature__mark) { position: relative; }
  .card-meta { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; color: var(--ink-faint); text-transform: uppercase; }
  .card-feature .card-meta { color: var(--accent); }
  .card-feature h3 { font-family: var(--serif); font-weight: 300; font-size: clamp(38px, 3.9vw, 56px); line-height: 1; color: var(--ink); }
  .card-feature p { max-width: 520px; font-size: 17px; line-height: 1.55; color: var(--ink-mute); }
  .card-row { flex: 1; display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 24px; align-items: center; padding: 20px; }
  .card-row img { width: 180px; height: 160px; object-fit: cover; }
  .book-object img, .showcase-phone img { max-width: none; }
  .card-row--text { grid-template-columns: minmax(0, 1fr); padding: 28px; }
  .card-row__body { display: flex; flex-direction: column; gap: 10px; }
  .card-row h3 { font-family: var(--serif); font-weight: 400; font-size: 28px; line-height: 1.12; color: var(--ink); }
  .card-row p { font-size: 15px; line-height: 1.5; color: var(--ink-mute); }

  /* ---------- FREE GUIDE + SIGNAL ---------- */
  .offer {
    position: relative; overflow: hidden;
    margin-bottom: 150px;
    padding: 96px 88px;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--line); border-top: 2px solid var(--accent);
  }
  .offer .glow { bottom: -260px; right: -160px; width: 640px; height: 640px; }
  .offer-copy { position: relative; grid-column: span 6; display: flex; flex-direction: column; gap: 22px; }
  .offer-copy h2 { font-size: clamp(36px, 4vw, 58px); line-height: 1.02; }
  .offer-copy > p { font-size: 17px; line-height: 1.6; color: var(--ink-dim); }
  .offer-copy strong { color: var(--ink); font-weight: 500; }
  .offer-list { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 24px; font-size: 15px; color: var(--ink-soft); }
  .offer-list li { display: flex; gap: 10px; }
  .offer-list li span { color: var(--accent); }
  .signal { position: relative; grid-column: 8 / span 5; padding: 36px; background: rgba(11,11,12,0.7); border: 1px solid #2e2b25; }
  .signal-form { display: grid; gap: 14px; }
  .signal-form label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.16em; color: var(--ink-mute); text-transform: uppercase; }
  .signal-form input[type="email"] {
    min-height: 56px; padding: 0 18px;
    background: var(--bg); border: 1px solid var(--line-2); border-radius: 0;
    color: var(--ink); font-family: var(--sans); font-size: 16px;
    transition: border-color .2s ease;
  }
  .signal-form input[type="email"]::placeholder { color: var(--ink-faint); }
  .signal-form input[type="email"]:focus { border-color: var(--accent); }
  .signal-form .btn { width: 100%; }
  .signal-form .btn:disabled { opacity: 0.5; cursor: default; }
  .signal-status { min-height: 1.4em; margin-top: 12px; font-size: 15px; }
  .signal-status.ok { color: var(--accent); }
  .signal-status.err { color: var(--ink-dim); }
  .guide-download[hidden] { display: none; }
  .signal-fineprint { margin-top: 10px; font-size: 13px; line-height: 1.55; color: var(--ink-faint); }

  /* ---------- CLOSE + FOOTER ---------- */
  .close { position: relative; padding: 180px 0 120px; display: flex; flex-direction: column; align-items: center; gap: 36px; text-align: center; overflow: hidden; }
  .close .glow { top: 60px; left: 50%; width: 900px; height: 500px; margin-left: -450px; background: radial-gradient(ellipse, rgba(var(--accent-rgb), 0.12) 0%, rgba(var(--accent-rgb), 0) 65%); }
  .close p { position: relative; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(56px, 8.9vw, 128px); line-height: 0.95; letter-spacing: -0.035em; color: var(--ink); }
  .close p em { color: var(--accent); }
  .close .btn { position: relative; }

  /* ---------- MOTION (only when the visitor allows it) ---------- */
  @keyframes gtFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
  @keyframes gtSweep { from { transform: translateX(-100%); } to { transform: translateX(250%); } }
  @media (prefers-reduced-motion: no-preference) {
    .pulse { animation: gtPulse 2.2s ease-out infinite; }
    .hero-grain { animation: gtGrain 1.2s steps(4) infinite; }
    .book-object { animation: gtFloat 7s ease-in-out infinite; }
    .field-log__sweep::before { animation: gtSweep 5s linear infinite; }
    .rise { animation: gtRise 1s cubic-bezier(.2,.7,.2,1) both; animation-delay: var(--d, 0ms); }
    .reveal.reveal-ready { opacity: 0; transform: translateY(18px); transition: opacity .8s ease, transform .8s cubic-bezier(.2,.7,.2,1); }
    .reveal.reveal-ready.in { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition: none !important; }
    .card:hover, .guide-card:hover { transform: none; }
  }

  /* ---------- TABLET ---------- */
  @media (max-width: 1100px) {
    :root { --gutter: 40px; }
    .hero-media { width: 56%; }
    .field-log { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .field-log > div:first-of-type, .field-log__now { grid-column: 1 / -1; }
    .field-log > div + div { border-left: 0; }
    .field-log > div:nth-of-type(3), .field-log > div:nth-of-type(4) { border-left: 1px solid rgba(236,234,227,0.08); }
    .field-log > div:nth-of-type(2), .field-log > div:nth-of-type(3), .field-log > div:nth-of-type(4), .field-log__now { border-top: 1px solid rgba(236,234,227,0.08); }
    .book-stage { height: 600px; }
    .book-object { width: 300px; }
    .guides, .writing-grid, .app-notes { grid-template-columns: 1fr; }
    .about-head, .about-copy { grid-column: 1 / -1; }
    .about-copy { margin-top: 40px; }
    .principles-head { grid-column: 1 / -1; position: static; margin-bottom: 40px; }
    .principles ol { grid-column: 1 / -1; }
    .offer { padding: 64px 48px; }
    .offer-copy, .signal { grid-column: 1 / -1; }
    .signal { margin-top: 40px; }
  }

  /* ---------- PHONE ---------- */
  @media (max-width: 720px) {
    :root { --gutter: 20px; }
    body { font-size: 16px; }
    .hero { min-height: 0; }
    .hero-media { left: 0; width: 100%; bottom: auto; height: 560px; }
    .hero-media img { object-position: 62% 30%; }
    .hero-media::after { background: linear-gradient(0deg, var(--bg) 6%, rgba(11,11,12,0.72) 40%, rgba(11,11,12,0.15) 100%); }
    .hero-texture .glow { display: none; }
    .site-nav { margin-top: 12px; padding: 0 8px 0 10px; gap: 12px; }
    .site-mark span { display: none; }
    .site-links { gap: 18px; font-size: 14px; }
    .nav-book, .guide-days { display: none !important; }
    .nav-guide { padding: 0 14px; }
    .hero-copy { padding: 250px 0 40px; gap: 24px; }
    .hero-role { align-items: flex-start; font-size: 10px; line-height: 1.7; letter-spacing: 0.14em; }
    .hero-role .pulse { margin-top: 5px; }
    .hero h1 { font-size: 54px; line-height: 0.98; }
    .lede { font-size: 17px; }
    .hero-actions .btn { width: 100%; }
    .field-log { margin-bottom: 40px; }
    .field-log > div { padding: 18px 14px; }
    .field-log__value { font-size: 38px; }
    .field-log__now p { font-size: 19px; }
    .field-log__label { font-size: 9px; line-height: 1.5; letter-spacing: 0.12em; }
    .about { padding-top: 72px; }
    .about-head { gap: 18px; }
    .about-portrait { width: 112px; height: 112px; margin-top: 8px; }
    .about-copy { margin-top: 28px; gap: 18px; font-size: 17px; }
    .book { padding: 72px 0 80px; }
    .book-grid { grid-template-columns: 1fr; gap: 8px; }
    .book-stage { height: 440px; }
    .book-object { width: 230px; }
    .book-shadow { width: 240px; margin-left: -120px; bottom: 36px; }
    .book-body { gap: 20px; }
    .book-sub { font-size: 20px; }
    .book-desc { font-size: 16px; }
    .book-buy .btn { width: 100%; }
    .guides { padding-bottom: 96px; gap: 14px; }
    .guide-card { grid-template-columns: 64px minmax(0, 1fr); gap: 20px; padding: 22px 20px; }
    .guide-num { height: 96px; font-size: 44px; }
    .guide-card__name { font-size: 22px; }
    .apps { padding: 88px 0 96px; }
    .apps-head { align-items: flex-start; text-align: left; }
    .apps-head p { font-size: 16px; }
    .showcase { margin-top: 48px; aspect-ratio: 350 / 290; }
    .showcase-browser { left: 0; top: 12%; width: 84%; }
    .showcase-browser__bar { height: 22px; padding: 0 8px; gap: 5px; }
    .showcase-browser__bar span { width: 6px; height: 6px; }
    .showcase-browser img { aspect-ratio: 860 / 620; }
    .showcase-phone { right: 0; width: 38%; box-shadow: 0 30px 60px rgba(0,0,0,0.8), 0 0 0 5px #161614; }
    .app-notes { margin-top: 40px; gap: 32px; }
    .app-note h3 { font-size: 28px; }
    .principles { padding: 96px 0; }
    .principles-head { margin-bottom: 24px; }
    .principle { grid-template-columns: 40px minmax(0, 1fr); gap: 12px; padding: 22px 0; }
    .writing { padding-top: 96px; gap: 32px; }
    .card-feature { min-height: 400px; padding: 28px 24px; }
    .card-feature__mark { font-size: 150px; top: 8px; left: 16px; }
    .card-row { grid-template-columns: 1fr; padding: 14px; }
    .card-row img { width: 100%; height: auto; aspect-ratio: 16 / 9; }
    .card-row h3 { font-size: 24px; }
    .offer { padding: 36px 22px; margin-bottom: 96px; }
    .offer-list { grid-template-columns: 1fr; }
    .signal { padding: 24px 18px; margin-top: 32px; }
    .close { padding: 110px 0 80px; gap: 28px; }
    .close p { font-size: 50px; }
    footer { flex-direction: column; align-items: flex-start; }
  }
</style>
</head>
<body>

<a class="skip-link" href="#main-content">Skip to main content</a>

<header class="hero">
  <div class="hero-media">
    <img src="/assets/about/garry-tipler-hero.webp" alt="Garry Tipler outdoors under the trees, looking up." width="1206" height="1063" fetchpriority="high" />
  </div>
  <div class="hero-texture" aria-hidden="true">
    <div class="glow"></div>
    <div class="hero-grain"></div>
    <div class="hero-lines"></div>
  </div>

  <div class="wrap" style="display: flex; flex-direction: column; flex: 1; width: 100%;">
    <nav class="site-nav" aria-label="Primary">
      <a class="site-mark" href="/" aria-label="Garry Tipler home">
        <img src="/favicon.svg" alt="" width="34" height="34" />
        <span aria-hidden="true">GARRY TIPLER</span>
      </a>
      <div class="site-links">
        <a class="nav-book" href="#book">Book</a>
        <a href="/writing/">Writing</a>
        <a class="nav-projects" href="#proof">Projects</a>
        <a class="nav-guide" href="#field-guide">Free <span class="guide-days">7-day </span>guide</a>
      </div>
    </nav>

    <div class="hero-copy">
      <p class="hero-role rise" style="--d:0ms"><span class="pulse" aria-hidden="true"></span><span>Author · Software Builder · Founder, Tenacious Individual Performance</span></p>
      <h1 class="display rise" style="--d:120ms">Systems for <em>rebuilding</em> a life.</h1>
      <p class="lede rise" style="--d:240ms">
        My rebuild started in a shelter. The systems that carried me out —
        discipline, training, and writing — are all here. I tested them on
        myself first, then wrote them down so you can run them too.
      </p>
      <div class="hero-actions rise" style="--d:320ms">
        <a class="btn btn-primary" href="#book">Read the book <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="#field-guide">Get the free guide</a>
        <a class="text-link" href="/writing/start-here/">Start reading <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>

    <!-- Field log rule: real numbers only, never estimated.
         Sessions comes from the SelfTrainer PWA and is hand-updated with its
         as-of date. Weeks counts whole weeks since data-start (owner-confirmed
         2026-01-01): computed at build, then updated in the browser. -->
    <aside class="field-log rise" style="--d:420ms" aria-labelledby="field-log-title">
      <span class="field-log__sweep" aria-hidden="true"></span>
      <div>
        <h2 class="field-log__title" id="field-log-title"><span class="pulse" aria-hidden="true"></span>Field log</h2>
        <p class="field-log__note">Proof of practice. Sessions as of Oct 1, 2026.</p>
      </div>
      <div>
        <span class="field-log__value" data-count>103</span>
        <span class="field-log__label">Sessions logged in SelfTrainer</span>
      </div>
      <div>
        <span class="field-log__value" id="weeks-in-system" data-count data-start={systemStart}>{weeksInSystem}</span>
        <span class="field-log__label">Weeks in the system</span>
      </div>
      <div>
        <span class="field-log__value" data-count>3</span>
        <span class="field-log__label">Titles shipped</span>
      </div>
      <div class="field-log__now">
        <span class="field-log__label">Now building</span>
        <p>SelfTrainer Native, headed for the App Store.</p>
      </div>
    </aside>
  </div>
</header>

<main id="main-content" tabindex="-1">

  <!-- ABOUT -->
  <div class="wrap">
    <section class="about" id="about" aria-labelledby="about-heading">
      <div class="about-head reveal">
        <span class="kicker">01 — About Garry</span>
        <h2 class="display" id="about-heading">Behind the work.</h2>
        <img class="about-portrait" src="/assets/about/garry-tipler-portrait.webp" alt="Portrait of Garry Tipler outdoors, looking up." width="320" height="320" loading="lazy" />
      </div>
      <div class="about-copy reveal">
        <p>I’m Garry Tipler. Before I was publishing books or building software, I was learning how to rebuild my own life. That journey began in a shelter, where creating a different future meant taking responsibility for the actions I could control.</p>
        <p>There was no single breakthrough that could replace the daily work. Training gave me something to return to. Writing helped me understand the process. Structure made it possible to keep going when motivation wasn’t enough.</p>
        <p>Today, I turn those experiences into books, practical field guides, and software, including SelfTrainer and FitPulse.</p>
        <p><strong>T.I.P. stands for Tenacious Individual Performance.</strong> It brings together the principles behind my work: personal responsibility, consistent execution, and building systems that can withstand real life.</p>
        <p>I’m not writing from a finish line. I’m still building, learning, testing, and refining.</p>
        <p>Everything shared here starts with that practice.</p>
      </div>
    </section>
  </div>

  <!-- BOOK -->
  <section class="book" id="book" aria-labelledby="book-heading">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap book-grid">
      <div class="book-stage reveal">
        <div class="book-shadow" aria-hidden="true"></div>
        <a class="book-object" href="https://www.amazon.com/dp/B0GX379N1L" aria-label="I Am the Proof on Amazon Kindle">
          <img src="/assets/books/i-am-the-proof-cover.webp" alt="Cover of I Am the Proof: Building in the Dark by Garry Tipler." width="600" height="960" loading="lazy" />
        </a>
      </div>
      <div class="book-body reveal">
        <span class="kicker">02 — The doctrine</span>
        <h2 class="display" id="book-heading">I Am the Proof</h2>
        <p class="book-sub">Building in the Dark — A Journey from a Shelter to My Higher Self</p>
        <p class="book-desc">The full story and the framework underneath it: where the rebuild started, and how the systems held when nothing else did.</p>
        <div class="book-buy">
          <a class="btn btn-primary" href="https://www.amazon.com/dp/B0GX379N1L">Get it on Kindle <span class="arrow" aria-hidden="true">→</span></a>
          <span class="book-price"><strong>$4.99</strong><span>Free on Kindle Unlimited</span></span>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="guides" aria-label="Field guides">
      <a class="guide-card reveal" href="https://garrytip.gumroad.com/l/discipline-field-guide">
        <span class="guide-num" aria-hidden="true">01</span>
        <span class="guide-card__body">
          <span class="guide-card__kicker">Field guide · $7</span>
          <span class="guide-card__name">The Discipline Training Field Guide</span>
          <span class="guide-card__desc">The core systems for daily discipline that survives bad days.</span>
          <span class="guide-card__cta">On Gumroad →</span>
        </span>
      </a>
      <a class="guide-card reveal" href="https://garrytip.gumroad.com/l/discipline-recovery-field-guide">
        <span class="guide-num" aria-hidden="true">02</span>
        <span class="guide-card__body">
          <span class="guide-card__kicker">Field guide · $7</span>
          <span class="guide-card__name">Discipline Recovery Field Guide</span>
          <span class="guide-card__desc">What to do when discipline slips — the system for getting back on track without starting over.</span>
          <span class="guide-card__cta">On Gumroad →</span>
        </span>
      </a>
    </div>

    <!-- FREE GUIDE + THE SIGNAL -->
    <section class="offer reveal" id="field-guide" aria-labelledby="discipline-rebuild-title">
      <div class="glow" aria-hidden="true"></div>
      <div class="offer-copy">
        <span class="kicker">03 — Free · 7 days</span>
        <h2 class="display" id="discipline-rebuild-title">You do not need another dramatic restart. You need a clear way to return.</h2>
        <p><strong>The 7-Day Discipline Rebuild</strong> is a short, practical protocol for restoring structure, rebuilding self-trust, and returning to action.</p>
        <ul class="offer-list">
          <li><span aria-hidden="true">01</span>A focused seven-day rebuilding protocol</li>
          <li><span aria-hidden="true">02</span>Simple daily actions and reflection prompts</li>
          <li><span aria-hidden="true">03</span>A printable discipline rebuild scorecard</li>
          <li><span aria-hidden="true">04</span>A sustainable plan for the next 14 days</li>
        </ul>
      </div>
      <div class="signal" id="signal">
        <form class="signal-form" id="signal-form" novalidate>
          <label for="signal-email">Email address</label>
          <input type="email" id="signal-email" name="email_address" placeholder="you@domain.com" autocomplete="email" required />
          <button type="submit" class="btn btn-primary" id="signal-submit">Send me the guide <span class="arrow" aria-hidden="true">→</span></button>
        </form>
        <p class="signal-status" id="signal-status" role="status" aria-live="polite"></p>
        <a class="text-link guide-download" id="guide-download" href="/assets/downloads/the-7-day-discipline-rebuild.pdf" download hidden>Download the guide (PDF) <span class="arrow" aria-hidden="true">→</span></a>
        <p class="signal-fineprint">You’ll also get The Signal: roughly once a month, a system, a fix, or a field note. Tested on me before it reaches you. No spam. Leave anytime.</p>
      </div>
    </section>
  </div>

  <!-- PROOF OF PRACTICE -->
  <section class="apps" id="proof" aria-labelledby="proof-heading">
    <div class="apps-grid" aria-hidden="true"></div>
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap">
      <div class="apps-head reveal">
        <span class="kicker">04 — The operating surface</span>
        <h2 class="display" id="proof-heading">The books are the doctrine. The apps are where it <em>runs.</em></h2>
        <p>Each system starts from lived pressure, gets tested in real routines, then gets refined into something cleaner, calmer, and repeatable.</p>
      </div>
      <div class="showcase reveal">
        <figure class="showcase-browser">
          <div class="showcase-browser__bar" aria-hidden="true"><span></span><span></span><span></span></div>
          <img src="/assets/fitpulse/fitpulse-dashboard.webp" alt="FitPulse dashboard showing the coach's decision queue." width="1916" height="835" loading="lazy" />
        </figure>
        <figure class="showcase-phone">
          <img src="/assets/selftrainer/selftrainer-home-up-next-pwa.webp" alt="SelfTrainer home screen showing the next session in the training rotation." width="1080" height="2348" loading="lazy" />
        </figure>
      </div>
      <div class="app-notes">
        <div class="app-note reveal">
          <div class="app-note__title">
            <h3>SelfTrainer</h3>
            <span class="app-status app-status--live"><span class="pulse" aria-hidden="true"></span>In progress</span>
          </div>
          <p>Execution-first training system for serious lifters — focused on sessions, progression, and the work itself.</p>
          <a class="text-link" href="/projects/selftrainer/">View the build <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="app-note reveal">
          <div class="app-note__title">
            <h3>FitPulse</h3>
            <span class="app-status">In development</span>
          </div>
          <p>A coaching operating system for trainers who need clearer client structure, program visibility, and performance context.</p>
          <a class="text-link" href="/projects/fitpulse/">View the project <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- WRITING + PRINCIPLES -->
  <div class="wrap">
    <!-- WRITING -->
    <section class="writing" aria-labelledby="writing-heading">
      <div class="writing-head reveal">
        <div>
          <span class="kicker">05 — Field notes</span>
          <h2 class="display" id="writing-heading">Writing</h2>
        </div>
        <a class="text-link" href="/writing/">Explore the writing library <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class:list={["writing-grid", latest.length === 0 && "writing-grid--single"]}>
        <a class="card card-feature reveal" href={getWritingPath(featured.data)}>
          <span class="glow" aria-hidden="true"></span>
          {featured.data.fragmentNumber && <span class="card-feature__mark" aria-hidden="true">#{featured.data.fragmentNumber}</span>}
          <span class="card-meta">Featured · {typeLabel(featured)} · {shortDate(featured)}</span>
          <h3>{featured.data.title}</h3>
          <p>{featured.data.summary}</p>
        </a>
        {latest.length > 0 && <div class="writing-side">
          {latest.map((entry, index) => (
            <a class={entry.data.heroImage ? "card card-row reveal" : "card card-row card-row--text reveal"} href={getWritingPath(entry.data)}>
              {entry.data.heroImage && <img src={entry.data.heroImage.src} alt="" loading="lazy" />}
              <div class="card-row__body">
                <span class="card-meta">{index === 0 ? "Latest · " : ""}{typeLabel(entry)} · {shortDate(entry)}</span>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.summary}</p>
              </div>
            </a>
          ))}
        </div>}
      </div>
    </section>

    <!-- PRINCIPLES -->
    <section class="principles" id="principles" aria-labelledby="principles-heading">
      <div class="principles-head reveal">
        <span class="kicker">06 — Standing principles</span>
        <h2 class="display" id="principles-heading">What the system runs on.</h2>
      </div>
      <ol>
        <li class="principle reveal"><span class="principle__num" aria-hidden="true">I.</span><span class="principle__text">Structure beats mood.</span></li>
        <li class="principle reveal"><span class="principle__num" aria-hidden="true">II.</span><span class="principle__text">Clear systems protect honest effort.</span></li>
        <li class="principle reveal"><span class="principle__num" aria-hidden="true">III.</span><span class="principle__text">Repetition builds identity before confidence arrives.</span></li>
        <li class="principle reveal"><span class="principle__num" aria-hidden="true">IV.</span><span class="principle__text">Recovery is not starting over — it is returning to the system.</span></li>
      </ol>
    </section>


  </div>

  <section class="close" aria-label="Closing">
    <div class="glow" aria-hidden="true"></div>
    <p class="reveal">The proof is <em>the work.</em></p>
    <a class="btn btn-ghost reveal" href="#book">Start with the book</a>
  </section>

</main>

<div class="wrap">
  <footer>
    <span class="footer-brand"><img src="/favicon.svg" alt="" width="26" height="26" />© 2026 Garry Tipler</span>
    <nav class="footer-links" aria-label="Connect">
      <a href="https://x.com/garry_tipler">X</a>
      <a href="https://garrytip.gumroad.com">Gumroad</a>
      <a href="https://medium.com/@Garry_Tipler">Medium</a>
    </nav>
  </footer>
</div>

<script is:inline>
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Reveal sections as they scroll into view.
  (function () {
    var items = document.querySelectorAll('.reveal');
    if (reduceMotion || !('IntersectionObserver' in window)) return;
    try {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      items.forEach(function (el) { el.classList.add('reveal-ready'); io.observe(el); });
    } catch (error) {
      items.forEach(function (el) { el.classList.remove('reveal-ready'); el.classList.add('in'); });
    }
  })();

  // Field log: weeks in the system counts forward from its start date.
  (function () {
    var el = document.getElementById('weeks-in-system');
    if (!el) return;
    var start = Date.parse(el.getAttribute('data-start') + 'T00:00:00');
    var weeks = Math.floor((Date.now() - start) / 604800000);
    if (weeks > Number(el.textContent)) el.textContent = String(weeks);
  })();

  // Field log: numbers count up once on load. The real values are already in
  // the HTML, so nothing changes without JavaScript or with reduced motion.
  (function () {
    if (reduceMotion || !window.requestAnimationFrame) return;
    var els = Array.prototype.slice.call(document.querySelectorAll('[data-count]'));
    var targets = els.map(function (el) { return Number(el.textContent) || 0; });
    var t0 = null, dur = 1800;
    function frame(t) {
      if (t0 === null) t0 = t;
      var p = Math.min(1, (t - t0) / dur);
      var e = 1 - Math.pow(1 - p, 3);
      els.forEach(function (el, i) { el.textContent = String(Math.round(targets[i] * e)); });
      if (p < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  })();

  // Principles: one at a time takes the light.
  (function () {
    var list = document.querySelector('.principles');
    var items = document.querySelectorAll('.principle');
    if (!list || !items.length) return;
    if (reduceMotion) { list.classList.add('is-static'); return; }
    var i = 0;
    function show() {
      items.forEach(function (el, j) { el.classList.toggle('is-active', j === i); });
      i = (i + 1) % items.length;
    }
    show();
    setInterval(show, 2600);
  })();

  // Kit subscription (custom HTML form, AJAX, no redirect).
  // A successful signup reveals the free guide download.
  (function () {
    var KIT_FORM_ID = '9676498';
    var form = document.getElementById('signal-form');
    var status = document.getElementById('signal-status');
    var button = document.getElementById('signal-submit');
    var download = document.getElementById('guide-download');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = document.getElementById('signal-email').value.trim();

      if (!email || email.indexOf('@') === -1) {
        status.textContent = 'Enter a valid email address.';
        status.className = 'signal-status err';
        return;
      }

      button.disabled = true;
      status.textContent = 'Sending…';
      status.className = 'signal-status';

      var data = new FormData();
      data.append('email_address', email);

      fetch('https://app.kit.com/forms/' + KIT_FORM_ID + '/subscriptions', {
        method: 'POST',
        body: data,
        headers: { 'Accept': 'application/json' }
      })
        .then(function (res) { return res.json(); })
        .then(function (json) {
          if (json.status === 'success' || json.subscription) {
            status.textContent = 'You’re in. Your guide is ready below — check your inbox to confirm The Signal.';
            status.className = 'signal-status ok';
            form.reset();
            button.disabled = false;
            if (download) download.hidden = false;
          } else {
            throw new Error('rejected');
          }
        })
        .catch(function () {
          status.textContent = 'That didn\'t send. Check the address and try again.';
          status.className = 'signal-status err';
          button.disabled = false;
        });
    });
  })();
</script>

