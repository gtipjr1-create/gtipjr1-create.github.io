---
import WritingList from "../../components/WritingList.astro";
import WritingIndexLayout from "../../layouts/WritingIndexLayout.astro";
import {
  getPublishedWritingEntries,
  getWritingPath,
  sortWritingByPublicationDate,
} from "../../lib/writing";

const publishedEntries = await getPublishedWritingEntries();
const octoberEntries = publishedEntries
  .filter((entry) => entry.data.series === "october-2026")
  .sort((left, right) => left.data.seriesDay! - right.data.seriesDay!);
const octoberByDay = new Map(octoberEntries.map((entry) => [entry.data.seriesDay!, entry]));
const latestOctober = octoberEntries.at(-1);
const octoberDays = Array.from({ length: 31 }, (_, index) => index + 1);
const padDay = (day: number) => String(day).padStart(2, "0");
const latestEntries = sortWritingByPublicationDate(publishedEntries).slice(0, 6);
const fragmentCount = publishedEntries.filter((entry) => entry.data.type === "fragment").length;
const essayCount = publishedEntries.filter((entry) => entry.data.type === "essay").length;
const pieces = (count: number) => `${count} ${count === 1 ? "piece" : "pieces"}`;
const collectionNote = `${fragmentCount} ${fragmentCount === 1 ? "fragment" : "fragments"} · ${essayCount} ${essayCount === 1 ? "essay" : "essays"}`;
---

<WritingIndexLayout
  title="Writing"
  description="Essays and fragments on discipline, structure, execution, recovery, self-command, and the long rebuild."
  canonicalPath="/writing/"
  eyebrow="The Writing Chambers"
  note={collectionNote}
>
  <section class="library-section" aria-labelledby="october-feature-heading">
    <div class="october-feature">
      <div class="october-feature-text">
        <p class="collection-count">October Writing Challenge · 2026</p>
        <h2 id="october-feature-heading" class="october-feature-title">October: 31 Days of Writing</h2>
        <p class="collection-description">31 days. No central theme. Just the day and what it brings.</p>
        <p class="october-feature-progress">{octoberEntries.length} of 31 days written</p>
        {latestOctober && (
          <a class="october-feature-latest" href={getWritingPath(latestOctober.data)}>
            <span class="october-feature-latest-label">Latest</span>
            <span class="october-feature-latest-title">{latestOctober.data.title}</span>
          </a>
        )}
        <a class="collection-cta" href="/writing/october-2026/">Browse October <span aria-hidden="true">→</span></a>
      </div>
      <ol class="october-days" aria-label="October days">
        {octoberDays.map((day) => {
          const entry = octoberByDay.get(day);
          return entry ? (
            <li><a class="october-day is-written" href={getWritingPath(entry.data)} aria-label={`Day ${day}: ${entry.data.title}`}>{padDay(day)}</a></li>
          ) : (
            <li><span class="october-day">{padDay(day)}</span></li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="library-section" aria-labelledby="collections-heading">
    <h2 id="collections-heading" class="library-kicker" style="margin-bottom: 28px;">Collections</h2>
    <div class="collection-grid">
      <a class="collection-card" href="/writing/fragments/">
        <span class="collection-numeral" aria-hidden="true">{fragmentCount}</span>
        <span class="collection-count">The first chamber · {pieces(fragmentCount)}</span>
        <span class="collection-title">Fragments</span>
        <span class="collection-description">Numbered field notes from the work of rebuilding.</span>
        <span class="collection-cta">Browse fragments <span aria-hidden="true">→</span></span>
      </a>

      <a class="collection-card" href="/writing/essays/">
        <span class="collection-numeral" aria-hidden="true">{essayCount}</span>
        <span class="collection-count">The second chamber · {pieces(essayCount)}</span>
        <span class="collection-title">Essays</span>
        <span class="collection-description">Longer arguments, observations, and systems put into practice.</span>
        <span class="collection-cta">Browse essays <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <section class="library-section" aria-labelledby="discovery-heading">
    <h2 id="discovery-heading" class="library-kicker" style="margin-bottom: 28px;">Find a way in</h2>
    <div class="discovery-grid">
      <a class="discovery-card" href="/writing/start-here/">
        <svg class="discovery-icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M20 4 V36 M4 20 H36"></path><circle cx="20" cy="20" r="14"></circle></svg>
        <span class="discovery-text">
          <span class="discovery-title">Start Here</span>
          <span class="discovery-description">A deliberate path through the foundational pieces.</span>
        </span>
        <span class="collection-cta">Begin here <span aria-hidden="true">→</span></span>
      </a>

      <a class="discovery-card" href="/writing/archive/">
        <svg class="discovery-icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><rect x="6" y="8" width="28" height="8"></rect><rect x="6" y="18" width="28" height="8"></rect><rect x="6" y="28" width="28" height="6"></rect></svg>
        <span class="discovery-text">
          <span class="discovery-title">Archive</span>
          <span class="discovery-description">Browse all writing by year.</span>
        </span>
        <span class="collection-cta">View archive <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <section class="library-section library-section--split" aria-labelledby="latest-heading">
    <div class="library-section-heading">
      <p class="library-kicker">Latest</p>
      <h2 id="latest-heading">Recent writing</h2>
      <a class="back-link" href="/writing/archive/">View all writing <span aria-hidden="true">→</span></a>
    </div>
    <WritingList entries={latestEntries} emptyMessage="Published writing will appear here." />
  </section>
</WritingIndexLayout>
