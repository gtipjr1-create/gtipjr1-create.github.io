---
import { render, type CollectionEntry } from "astro:content";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import {
  calculateReadingTime,
  getAdjacentWritingEntries,
  getPublishedWritingEntries,
  getStartHereEntries,
  getWritingCollectionSegment,
  resolveRelatedWritingEntries,
} from "../../../lib/writing";

export async function getStaticPaths() {
  const entries = await getPublishedWritingEntries();
  const startHereEntries = getStartHereEntries(entries);

  return entries.map((entry) => {
    const adjacentEntries = getAdjacentWritingEntries(entry, entries);
    const relatedEntries = resolveRelatedWritingEntries(entry, entries);

    return {
      params: {
        collection: getWritingCollectionSegment(entry.data),
        slug: entry.data.slug,
      },
      props: { entry, relatedEntries, startHereEntries, ...adjacentEntries },
    };
  });
}

interface Props {
  entry: CollectionEntry<"writing">;
  previous?: CollectionEntry<"writing">;
  next?: CollectionEntry<"writing">;
  relatedEntries: CollectionEntry<"writing">[];
  startHereEntries: CollectionEntry<"writing">[];
}

const { entry, previous, next, relatedEntries, startHereEntries } = Astro.props;
const { Content } = await render(entry);
const readingTime = calculateReadingTime(entry.body ?? "");
---

<ArticleLayout
  entry={entry}
  readingTime={readingTime}
  previous={previous}
  next={next}
  relatedEntries={relatedEntries}
  startHereEntries={startHereEntries}
>
  <Content />
</ArticleLayout>
