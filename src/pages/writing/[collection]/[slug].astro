---
import { render, type CollectionEntry } from "astro:content";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import {
  calculateReadingTime,
  getAdjacentWritingEntries,
  getPublishedWritingEntries,
  getWritingCollectionSegment,
} from "../../../lib/writing";

export async function getStaticPaths() {
  const entries = await getPublishedWritingEntries();

  return entries.map((entry) => {
    const adjacentEntries = getAdjacentWritingEntries(entry, entries);

    return {
      params: {
        collection: getWritingCollectionSegment(entry.data),
        slug: entry.data.slug,
      },
      props: { entry, ...adjacentEntries },
    };
  });
}

interface Props {
  entry: CollectionEntry<"writing">;
  previous?: CollectionEntry<"writing">;
  next?: CollectionEntry<"writing">;
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const readingTime = calculateReadingTime(entry.body ?? "");
---

<ArticleLayout entry={entry} readingTime={readingTime} previous={previous} next={next}>
  <Content />
</ArticleLayout>
